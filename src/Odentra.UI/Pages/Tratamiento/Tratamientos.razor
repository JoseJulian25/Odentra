@page "/tratamientos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Tratamientos.Ver")]
@attribute [Authorize]
@using Odentra.Data.Entities
@using Odentra.Services.Pagos
@using Odentra.Services.Tratamientos
@using Odentra.Services.Tratamientos.DTOs
@using Odentra.UI.Components
@using Odentra.UI.Formatting
@inject ITratamientoService TratamientoService
@inject IJSRuntime JS

@*
    PÁGINA PRINCIPAL DEL MÓDULO DE TRATAMIENTOS (ruta /tratamientos)

    Contiene dos pestañas:
      1. Catálogo: mantenimiento de los tratamientos y sus precios base.
      2. Realizados: tratamientos aplicados a pacientes, con estado clínico y estado de pago.
         El detalle, las acciones (completar, reabrir, cancelar) y el acceso a Pagos
         se resuelven en una ventana dentro de esta misma página.

    La página NO usa DbContext directamente: toda la lógica pasa por ITratamientoService.
*@

<PageTitle>Tratamientos · Odentra</PageTitle>

<div class="tratamientos-page">
    <div class="top-header">
        <h1 class="page-title">Tratamientos</h1>

        @if (pestanaActiva == "catalogo")
        {
            <AuthorizeView Policy="Tratamientos.Crear">
                <Authorized>
                    <button type="button" class="btn-primary" @onclick="AbrirNuevoCatalogo">
                        <span class="icon-plus">+</span> Nuevo tratamiento
                    </button>
                </Authorized>
            </AuthorizeView>
        }
        else
        {
            <AuthorizeView Policy="Tratamientos.Crear">
                <Authorized>
                    <button type="button" class="btn-primary" @onclick="AbrirNuevoRealizadoAsync">
                        <span class="icon-plus">+</span> Registrar tratamiento
                    </button>
                </Authorized>
            </AuthorizeView>
        }
    </div>

    <div class="tabs-container">
        <button type="button"
                class="tab-button @(pestanaActiva == "catalogo" ? "active" : "")"
                @onclick='() => CambiarPestanaAsync("catalogo")'>
            Catálogo
        </button>
        <button type="button"
                class="tab-button @(pestanaActiva == "realizados" ? "active" : "")"
                @onclick='() => CambiarPestanaAsync("realizados")'>
            Realizados
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert-success" role="status">@mensajeExito</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorPagina))
    {
        <div class="alert-error page-alert" role="alert">
            <span>@errorPagina</span>
            <button type="button" class="alert-close" @onclick="CerrarErrorPagina" aria-label="Cerrar">×</button>
        </div>
    }

    <div class="filter-card">
        <div class="search-box">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="11" cy="11" r="8" stroke-width="2" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2" />
            </svg>
            <input type="text"
                   value="@busqueda"
                   @oninput="OnBusquedaInput"
                   placeholder="@(pestanaActiva == "catalogo" ? "Buscar tratamiento..." : "Buscar paciente, tratamiento u odontólogo...")"
                   class="search-input"
                   aria-label="Buscar" />
        </div>

        <div class="status-select-container">
            @if (pestanaActiva == "catalogo")
            {
                <select @bind="filtroEstadoCatalogo" @bind:after="OnFiltroChanged" class="status-select" aria-label="Filtrar por estado">
                    <option value="Todos">Todos</option>
                    <option value="Activo">Activo</option>
                    <option value="Inactivo">Inactivo</option>
                </select>
            }
            else
            {
                <select @bind="filtroEstadoRealizados" @bind:after="OnFiltroChanged" class="status-select" aria-label="Filtrar por estado">
                    <option value="Todos">Todos</option>
                    <option value="En proceso">En proceso</option>
                    <option value="Completado">Completado</option>
                    <option value="Cancelado">Cancelado</option>
                </select>
            }
        </div>
    </div>

    @* ================= PESTAÑA CATÁLOGO ================= *@
    @if (pestanaActiva == "catalogo")
    {
        <div class="table-card">
            <div class="table-scroll">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th style="width: 25%;">TRATAMIENTO</th>
                            <th style="width: 40%;">DESCRIPCIÓN</th>
                            <th style="width: 15%;">PRECIO BASE</th>
                            <th style="width: 10%;">ESTADO</th>
                            <th style="width: 10%; text-align: center;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="5" class="empty-state">Cargando catálogo...</td>
                            </tr>
                        }
                        else if (catalogo is null || catalogo.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="empty-state">No hay tratamientos para mostrar con los filtros aplicados.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in catalogo.Items)
                            {
                                <tr>
                                    <td class="col-main">@item.Nombre</td>
                                    <td class="col-desc">@(string.IsNullOrWhiteSpace(item.Descripcion) ? "—" : item.Descripcion)</td>
                                    <td class="col-price">@Formato.Moneda(item.PrecioBase)</td>
                                    <td>
                                        <span class="@(item.Estado == EstadoRegistro.Activo ? "status-active" : "status-inactive")">
                                            @(item.Estado == EstadoRegistro.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="col-actions">
                                        <AuthorizeView Policy="Tratamientos.Editar">
                                            <Authorized>
                                                <button type="button"
                                                        class="btn-action"
                                                        title="Editar"
                                                        aria-label="Editar @item.Nombre"
                                                        @onclick="() => AbrirEditarCatalogoAsync(item)">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="action-icon">
                                                        <path d="M12 20h9" />
                                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                                                    </svg>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (catalogo is not null)
            {
                <div class="table-footer">
                    <span>@catalogo.TotalRegistros @(catalogo.TotalRegistros == 1 ? "registro" : "registros")</span>
                    <div class="pagination">
                        <button type="button"
                                class="page-btn"
                                disabled="@(!catalogo.HayPaginaAnterior)"
                                @onclick="() => IrPaginaCatalogoAsync(paginaCatalogo - 1)"
                                aria-label="Página anterior">‹</button>

                        @foreach (var numero in PaginasVisibles(paginaCatalogo, catalogo.TotalPaginas))
                        {
                            <button type="button"
                                    class="page-btn @(numero == paginaCatalogo ? "active" : "")"
                                    @onclick="() => IrPaginaCatalogoAsync(numero)">@numero</button>
                        }

                        <button type="button"
                                class="page-btn"
                                disabled="@(!catalogo.HayPaginaSiguiente)"
                                @onclick="() => IrPaginaCatalogoAsync(paginaCatalogo + 1)"
                                aria-label="Página siguiente">›</button>
                    </div>
                </div>
            }
        </div>
    }

    @* ================= PESTAÑA REALIZADOS ================= *@
    @if (pestanaActiva == "realizados")
    {
        <div class="table-card">
            <div class="table-scroll">
                <table class="custom-table realized-table">
                    <thead>
                        <tr>
                            <th style="width: 14%;">PACIENTE</th>
                            <th style="width: 16%;">TRATAMIENTO</th>
                            <th style="width: 13%;">ODONTÓLOGO</th>
                            <th style="width: 9%;">FECHA</th>
                            <th style="width: 7%;">PIEZA</th>
                            <th style="width: 10%;">PRECIO</th>
                            <th style="width: 10%;">ESTADO</th>
                            <th style="width: 10%;">PAGO</th>
                            <th style="width: 11%; text-align: center;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="9" class="empty-state">Cargando tratamientos realizados...</td>
                            </tr>
                        }
                        else if (realizados is null || realizados.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="empty-state">
                                    <strong>No hay tratamientos realizados</strong>
                                    <span>Prueba con otro filtro o registra un tratamiento para un paciente.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in realizados.Items)
                            {
                                <tr>
                                    <td class="col-main">@item.Paciente</td>
                                    <td>@item.Tratamiento</td>
                                    <td class="col-desc">@item.Odontologo</td>
                                    <td class="col-date">@Formato.Fecha(item.Fecha)</td>
                                    <td class="col-tooth">@(item.PiezaDental ?? "—")</td>
                                    <td class="col-price">@Formato.Moneda(item.Precio)</td>
                                    <td><EstadoTratamientoBadge Estado="item.Estado" /></td>
                                    <td>
                                        <span class="status-badge @EstadoFinancieroUi.Clase(item.EstadoPago)">
                                            @EstadoFinancieroUi.Texto(item.EstadoPago)
                                        </span>
                                    </td>
                                    <td class="col-actions">
                                        <div class="action-group">
                                            @if (item.Estado == EstadoTratamiento.EnProceso && item.Saldo > 0)
                                            {
                                                <AuthorizeView Policy="Pagos.Crear">
                                                    <Authorized>
                                                        <a class="btn-action"
                                                           href="/pagos/@item.Id"
                                                           title="Registrar pago"
                                                           aria-label="Registrar pago del tratamiento de @item.Paciente">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="action-icon">
                                                                <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
                                                                <path d="M2.5 10h19" />
                                                            </svg>
                                                        </a>
                                                    </Authorized>
                                                </AuthorizeView>
                                            }

                                            <button type="button"
                                                    class="btn-action"
                                                    title="Ver detalle"
                                                    aria-label="Ver detalle del tratamiento de @item.Paciente"
                                                    @onclick="() => VerDetalleAsync(item.Id)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="action-icon">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                                    <circle cx="12" cy="12" r="3" />
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (realizados is not null)
            {
                <div class="table-footer">
                    <span>@realizados.TotalRegistros @(realizados.TotalRegistros == 1 ? "registro" : "registros")</span>
                    <div class="pagination">
                        <button type="button"
                                class="page-btn"
                                disabled="@(!realizados.HayPaginaAnterior)"
                                @onclick="() => IrPaginaRealizadosAsync(paginaRealizados - 1)"
                                aria-label="Página anterior">‹</button>

                        @foreach (var numero in PaginasVisibles(paginaRealizados, realizados.TotalPaginas))
                        {
                            <button type="button"
                                    class="page-btn @(numero == paginaRealizados ? "active" : "")"
                                    @onclick="() => IrPaginaRealizadosAsync(numero)">@numero</button>
                        }

                        <button type="button"
                                class="page-btn"
                                disabled="@(!realizados.HayPaginaSiguiente)"
                                @onclick="() => IrPaginaRealizadosAsync(paginaRealizados + 1)"
                                aria-label="Página siguiente">›</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ============================================================================
   MODAL: NUEVO / EDITAR TRATAMIENTO DEL CATÁLOGO
   ============================================================================ *@
@if (mostrarModalCatalogo)
{
    <div class="modal-backdrop">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="catalogo-modal-title">
            <EditForm Model="catalogoForm" OnValidSubmit="GuardarCatalogoAsync">
                <DataAnnotationsValidator />

                <div class="modal-header">
                    <h3 class="modal-title" id="catalogo-modal-title">
                        @(catalogoForm.Id == 0 ? "Nuevo tratamiento" : $"Editar: {catalogoForm.Nombre}")
                    </h3>
                    <button type="button" class="modal-close-btn" @onclick="CerrarModales" aria-label="Cerrar">&times;</button>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorModal))
                {
                    <div class="alert-error modal-alert" role="alert">@errorModal</div>
                }

                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label" for="catalogo-nombre">Nombre del tratamiento</label>
                        <InputText id="catalogo-nombre" @bind-Value="catalogoForm.Nombre" class="form-control" />
                        <ValidationMessage For="() => catalogoForm.Nombre" class="field-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="catalogo-descripcion">Descripción</label>
                        <InputTextArea id="catalogo-descripcion"
                                       @bind-Value="catalogoForm.Descripcion"
                                       rows="3"
                                       class="form-control resize-none" />
                        <ValidationMessage For="() => catalogoForm.Descripcion" class="field-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="catalogo-precio">Precio base (RD$)</label>
                        <InputNumber id="catalogo-precio"
                                     @bind-Value="catalogoForm.PrecioBase"
                                     step="0.01"
                                     class="form-control" />
                        <ValidationMessage For="() => catalogoForm.PrecioBase" class="field-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="catalogo-estado">Estado</label>
                        <InputSelect id="catalogo-estado" @bind-Value="catalogoForm.Estado" class="form-control">
                            <option value="@EstadoRegistro.Activo">Activo</option>
                            <option value="@EstadoRegistro.Inactivo">Inactivo</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancel" @onclick="CerrarModales" disabled="@guardando">Cancelar</button>
                    <button type="submit" class="btn-primary" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ============================================================================
   MODAL: REGISTRAR / EDITAR TRATAMIENTO REALIZADO
   Sin selector de estado: el alta siempre queda En proceso y el estado se cambia
   desde el detalle con las acciones Completar, Reabrir o Cancelar.
   ============================================================================ *@
@if (mostrarModalRealizado)
{
    <div class="modal-backdrop">
        <div class="modal-card modal-lg" role="dialog" aria-modal="true" aria-labelledby="realizado-modal-title">
            <EditForm Model="realizadoForm" OnValidSubmit="GuardarRealizadoAsync">
                <DataAnnotationsValidator />

                <div class="modal-header">
                    <h3 class="modal-title" id="realizado-modal-title">
                        @(realizadoForm.Id == 0 ? "Registrar tratamiento realizado" : "Editar tratamiento realizado")
                    </h3>
                    <button type="button" class="modal-close-btn" @onclick="CerrarModales" aria-label="Cerrar">&times;</button>
                </div>

                @if (!string.IsNullOrWhiteSpace(errorModal))
                {
                    <div class="alert-error modal-alert" role="alert">@errorModal</div>
                }

                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label" for="realizado-buscar-paciente">Buscar paciente</label>
                            <input id="realizado-buscar-paciente"
                                   type="search"
                                   class="form-control"
                                   placeholder="Nombre o apellido..."
                                   disabled="@realizadoForm.TienePagos"
                                   @bind="busquedaPaciente"
                                   @bind:event="oninput" />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="realizado-paciente">Paciente</label>
                            <InputSelect id="realizado-paciente"
                                         @bind-Value="realizadoForm.PacienteId"
                                         @bind-Value:after="OnPacienteCambiadoAsync"
                                         disabled="@realizadoForm.TienePagos"
                                         class="form-control">
                                <option value="0">Seleccione un paciente...</option>
                                @foreach (var paciente in PacientesFiltrados)
                                {
                                    <option value="@paciente.Id">@paciente.Nombre@(paciente.Activo ? string.Empty : " (inactivo)")</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => realizadoForm.PacienteId" class="field-error" />
                            @if (realizadoForm.TienePagos)
                            {
                                <p class="form-hint">El paciente no se puede cambiar porque el tratamiento ya tiene pagos registrados.</p>
                            }
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label" for="realizado-tratamiento">Tratamiento del catálogo</label>
                            <InputSelect id="realizado-tratamiento"
                                         @bind-Value="realizadoForm.TratamientoId"
                                         @bind-Value:after="OnTratamientoSeleccionado"
                                         class="form-control">
                                <option value="0">Seleccione un tratamiento...</option>
                                @foreach (var tratamiento in TratamientosDisponibles)
                                {
                                    <option value="@tratamiento.Id">@tratamiento.Nombre (@Formato.Moneda(tratamiento.PrecioBase))@(tratamiento.Activo ? string.Empty : " (inactivo)")</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => realizadoForm.TratamientoId" class="field-error" />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="realizado-odontologo">Odontólogo</label>
                            <InputSelect id="realizado-odontologo" @bind-Value="realizadoForm.OdontologoId" class="form-control">
                                <option value="0">Seleccione un odontólogo...</option>
                                @foreach (var odontologo in OdontologosDisponibles)
                                {
                                    <option value="@odontologo.Id">@odontologo.Nombre@(odontologo.Activo ? string.Empty : " (inactivo)")</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => realizadoForm.OdontologoId" class="field-error" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="realizado-consulta">Consulta (opcional)</label>
                        <InputSelect id="realizado-consulta" @bind-Value="realizadoForm.ConsultaId" class="form-control">
                            <option value="">Sin consulta asociada</option>
                            @foreach (var consulta in consultasPaciente)
                            {
                                <option value="@consulta.Id">@Formato.Fecha(consulta.Fecha) · @consulta.Motivo</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label" for="realizado-fecha">Fecha</label>
                            <InputDate id="realizado-fecha"
                                       @bind-Value="realizadoForm.Fecha"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       class="form-control" />
                            <ValidationMessage For="() => realizadoForm.Fecha" class="field-error" />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="realizado-pieza">Pieza dental</label>
                            <InputSelect id="realizado-pieza" @bind-Value="realizadoForm.PiezaDentalId" class="form-control">
                                <option value="">Ninguna / No aplica</option>
                                @foreach (var pieza in piezas)
                                {
                                    <option value="@pieza.Id">@pieza.NumeroFDI · @pieza.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="realizado-precio">Precio (RD$)</label>
                        <InputNumber id="realizado-precio"
                                     @bind-Value="realizadoForm.Precio"
                                     step="0.01"
                                     class="form-control" />
                        <ValidationMessage For="() => realizadoForm.Precio" class="field-error" />
                        @if (realizadoForm.Id == 0)
                        {
                            <p class="form-hint">
                                El tratamiento se registrará <strong>En proceso</strong>. Se marca como completado manualmente desde su detalle.
                            </p>
                        }
                        else
                        {
                            <p class="form-hint">
                                El precio no puede quedar por debajo de lo ya pagado.
                            </p>
                        }
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="realizado-observaciones">Observaciones</label>
                        <InputTextArea id="realizado-observaciones"
                                       @bind-Value="realizadoForm.Observaciones"
                                       rows="2"
                                       placeholder="Notas clínicas..."
                                       class="form-control resize-none" />
                        <ValidationMessage For="() => realizadoForm.Observaciones" class="field-error" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancel" @onclick="CerrarModales" disabled="@guardando">Cancelar</button>
                    <button type="submit" class="btn-primary" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ============================================================================
   MODAL: DETALLE DEL TRATAMIENTO REALIZADO
   Muestra datos clínicos y financieros, y las acciones permitidas por el estado.
   ============================================================================ *@
@if (mostrarDetalle && detalle is not null)
{
    <div class="modal-backdrop">
        <div class="modal-card modal-lg" role="dialog" aria-modal="true" aria-labelledby="detalle-modal-title">
            <div class="modal-header">
                <h3 class="modal-title" id="detalle-modal-title">Detalle del tratamiento</h3>
                <button type="button" class="modal-close-btn" @onclick="CerrarModales" aria-label="Cerrar">&times;</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(exitoModal))
                {
                    <div class="alert-success" role="status">@exitoModal</div>
                }

                @if (!string.IsNullOrWhiteSpace(errorModal))
                {
                    <div class="alert-error" role="alert">@errorModal</div>
                }

                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Paciente</span>
                        <span class="detail-value">@detalle.Paciente</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Tratamiento</span>
                        <span class="detail-value">@detalle.Tratamiento</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Odontólogo</span>
                        <span class="detail-value">@detalle.Odontologo</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Fecha</span>
                        <span class="detail-value">@Formato.Fecha(detalle.Fecha)</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Pieza dental</span>
                        <span class="detail-value">@(string.IsNullOrWhiteSpace(detalle.PiezaDental) ? "Sin pieza específica" : detalle.PiezaDental)</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Estado</span>
                        <span class="detail-value"><EstadoTratamientoBadge Estado="detalle.Estado" /></span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Estado de pago</span>
                        <span class="detail-value">
                            <span class="status-badge @EstadoFinancieroUi.Clase(detalle.EstadoPago)">
                                @EstadoFinancieroUi.Texto(detalle.EstadoPago)
                            </span>
                        </span>
                    </div>
                </div>

                <AuthorizeView Policy="Pagos.Ver">
                    <Authorized>
                        <div class="detail-money">
                            <div>
                                <span class="detail-label">Precio</span>
                                <strong>@Formato.Moneda(detalle.Precio)</strong>
                            </div>
                            <div>
                                <span class="detail-label">Pagado</span>
                                <strong class="money-paid">@Formato.Moneda(detalle.Pagado)</strong>
                            </div>
                            <div>
                                <span class="detail-label">Saldo</span>
                                <strong class="@(detalle.Saldo > 0 ? "money-pending" : "money-paid")">@Formato.Moneda(detalle.Saldo)</strong>
                            </div>
                            <div>
                                <span class="detail-label">Pagos</span>
                                <strong>@detalle.CantidadPagos</strong>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>

                @if (!string.IsNullOrWhiteSpace(detalle.Observaciones))
                {
                    <div class="detail-notes">
                        <span class="detail-label">Observaciones</span>
                        <p>@detalle.Observaciones</p>
                    </div>
                }
            </div>

            <div class="modal-footer">
                @if (detalle.Estado == EstadoTratamiento.EnProceso)
                {
                    <AuthorizeView Policy="Tratamientos.Editar">
                        <Authorized>
                            <button type="button" class="btn-primary" disabled="@guardandoAccion"
                                    @onclick="MarcarCompletadoDetalleAsync">
                                Marcar completado
                            </button>
                        </Authorized>
                    </AuthorizeView>

                    @if (detalle.CantidadPagos == 0)
                    {
                        <AuthorizeView Policy="Tratamientos.Editar">
                            <Authorized>
                                <button type="button" class="btn-danger" disabled="@guardandoAccion"
                                        @onclick="CancelarDetalleAsync">
                                    Cancelar tratamiento
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    }
                    else
                    {
                        <span class="cancel-note">No se puede cancelar: tiene pagos registrados.</span>
                    }

                    @if (detalle.Saldo > 0)
                    {
                        <AuthorizeView Policy="Pagos.Crear">
                            <Authorized>
                                <a class="btn-primary" href="/pagos/@detalle.Id">Realizar pago</a>
                            </Authorized>
                        </AuthorizeView>
                    }
                }

                @if (detalle.Estado == EstadoTratamiento.Completado)
                {
                    <AuthorizeView Policy="Tratamientos.Editar">
                        <Authorized>
                            <button type="button" class="btn-cancel" disabled="@guardandoAccion"
                                    @onclick="ReabrirDetalleAsync">
                                Reabrir tratamiento
                            </button>
                        </Authorized>
                    </AuthorizeView>
                }

                @* Igual que SonrisaDigital: con pagos registrados, solo el Administrador puede editar. *@
                @if (detalle.Estado != EstadoTratamiento.Cancelado)
                {
                    <AuthorizeView Policy="Tratamientos.Editar">
                        <Authorized>
                            @if (detalle.CantidadPagos == 0)
                            {
                                <button type="button" class="btn-primary" @onclick="EditarDesdeDetalleAsync">
                                    Editar tratamiento
                                </button>
                            }
                            else
                            {
                                <AuthorizeView Roles="@RolesOdentra.Administrador">
                                    <Authorized Context="adminContext">
                                        <button type="button" class="btn-primary" @onclick="EditarDesdeDetalleAsync">
                                            Editar tratamiento
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </Authorized>
                    </AuthorizeView>
                }

                <button type="button" class="btn-cancel" @onclick="CerrarModales">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    // Cantidad de filas por página que se piden al servicio.
    private const int TamanoPagina = 10;

    // ----- Estado de navegación y filtros -----
    private string pestanaActiva = "catalogo";
    private string busqueda = string.Empty;
    private string filtroEstadoCatalogo = "Todos";
    private string filtroEstadoRealizados = "Todos";
    private int paginaCatalogo = 1;
    private int paginaRealizados = 1;

    // Versión de la búsqueda: sirve para descartar respuestas viejas del debounce.
    private int versionBusqueda;

    // ----- Datos que se muestran en pantalla -----
    private PaginaResultadoDto<TratamientoListItemDto>? catalogo;
    private PaginaResultadoDto<TratamientoRealizadoListItemDto>? realizados;

    // ----- Opciones de los formularios -----
    private List<PacienteOptionDto> pacientes = [];
    private List<OdontologoOptionDto> odontologos = [];
    private List<TratamientoOptionDto> tratamientos = [];
    private List<PiezaDentalOptionDto> piezas = [];
    private List<ConsultaOptionDto> consultasPaciente = [];
    private string busquedaPaciente = string.Empty;

    // ----- Estados de UI (carga, guardado y mensajes) -----
    private bool cargando;
    private bool guardando;
    private bool guardandoAccion;
    private string? errorPagina;
    private string? errorModal;
    private string? exitoModal;
    private string? mensajeExito;

    // ----- Control de modales y modelos de formulario -----
    private bool mostrarModalCatalogo;
    private bool mostrarModalRealizado;
    private bool mostrarDetalle;
    private TratamientoFormDto catalogoForm = new();
    private TratamientoRealizadoFormDto realizadoForm = new();
    private TratamientoRealizadoDetalleDto? detalle;

    // Al cargar la página se muestra primero el catálogo.
    protected override Task OnInitializedAsync() => CargarCatalogoAsync();

    // Pacientes y tratamientos disponibles: los activos más el que ya estuviera seleccionado.
    private IEnumerable<PacienteOptionDto> PacientesFiltrados
    {
        get
        {
            var termino = Normalizar(busquedaPaciente);
            return pacientes.Where(paciente =>
                (paciente.Activo || paciente.Id == realizadoForm.PacienteId)
                && Normalizar(paciente.Nombre).Contains(termino, StringComparison.Ordinal));
        }
    }

    private IEnumerable<TratamientoOptionDto> TratamientosDisponibles =>
        tratamientos.Where(tratamiento => tratamiento.Activo || tratamiento.Id == realizadoForm.TratamientoId);

    private IEnumerable<OdontologoOptionDto> OdontologosDisponibles =>
        odontologos.Where(odontologo => odontologo.Activo || odontologo.Id == realizadoForm.OdontologoId);

    /// <summary>
    /// Cambia entre Catálogo y Realizados.
    /// Limpia búsqueda/filtros de la pestaña anterior, reinicia páginas y recarga datos.
    /// </summary>
    private async Task CambiarPestanaAsync(string pestana)
    {
        if (pestanaActiva == pestana)
        {
            return;
        }

        versionBusqueda++;
        pestanaActiva = pestana;
        busqueda = string.Empty;
        paginaCatalogo = 1;
        paginaRealizados = 1;
        errorPagina = null;
        mensajeExito = null;

        if (pestana == "catalogo")
        {
            await CargarCatalogoAsync();
        }
        else
        {
            await CargarRealizadosAsync();
        }
    }

    /// <summary>
    /// Se ejecuta al cambiar el selector de estado.
    /// Vuelve a la página 1 porque el resultado filtrado puede tener menos páginas.
    /// </summary>
    private Task OnFiltroChanged() => pestanaActiva == "catalogo"
        ? CargarCatalogoAsync(1)
        : CargarRealizadosAsync(1);

    /// <summary>
    /// Búsqueda con "debounce": espera 300 ms desde la última tecla antes de consultar.
    /// Si el usuario sigue escribiendo, la versión cambia y la respuesta anterior se descarta.
    /// </summary>
    private async Task OnBusquedaInput(ChangeEventArgs args)
    {
        busqueda = args.Value?.ToString() ?? string.Empty;
        var version = ++versionBusqueda;

        await Task.Delay(300);

        if (version != versionBusqueda)
        {
            return;
        }

        if (pestanaActiva == "catalogo")
        {
            await CargarCatalogoAsync(1);
        }
        else
        {
            await CargarRealizadosAsync(1);
        }
    }

    /// <summary>
    /// Carga una página del catálogo desde el servicio.
    /// Si <paramref name="pagina"/> es mayor que 0, actualiza la página actual.
    /// </summary>
    private async Task CargarCatalogoAsync(int pagina = 0)
    {
        if (pagina > 0)
        {
            paginaCatalogo = pagina;
        }

        cargando = true;
        errorPagina = null;

        try
        {
            var estado = filtroEstadoCatalogo switch
            {
                "Activo" => EstadoRegistro.Activo,
                "Inactivo" => EstadoRegistro.Inactivo,
                _ => (EstadoRegistro?)null
            };

            catalogo = await TratamientoService.SearchCatalogoAsync(
                busqueda,
                estado,
                paginaCatalogo,
                TamanoPagina);
        }
        catch (Exception exception)
        {
            errorPagina = "No fue posible cargar el catálogo de tratamientos.";
            Console.Error.WriteLine(exception);
        }
        finally
        {
            cargando = false;
        }
    }

    /// <summary>
    /// Carga una página de tratamientos realizados con su estado clínico y financiero.
    /// </summary>
    private async Task CargarRealizadosAsync(int pagina = 0)
    {
        if (pagina > 0)
        {
            paginaRealizados = pagina;
        }

        cargando = true;
        errorPagina = null;

        try
        {
            var estado = filtroEstadoRealizados switch
            {
                "En proceso" => EstadoTratamiento.EnProceso,
                "Completado" => EstadoTratamiento.Completado,
                "Cancelado" => EstadoTratamiento.Cancelado,
                _ => (EstadoTratamiento?)null
            };

            realizados = await TratamientoService.SearchRealizadosAsync(
                busqueda,
                estado,
                paginaRealizados,
                TamanoPagina);
        }
        catch (Exception exception)
        {
            errorPagina = "No fue posible cargar los tratamientos realizados.";
            Console.Error.WriteLine(exception);
        }
        finally
        {
            cargando = false;
        }
    }

    private Task IrPaginaCatalogoAsync(int pagina)
    {
        if (catalogo is null || pagina < 1 || pagina > catalogo.TotalPaginas)
        {
            return Task.CompletedTask;
        }

        return CargarCatalogoAsync(pagina);
    }

    private Task IrPaginaRealizadosAsync(int pagina)
    {
        if (realizados is null || pagina < 1 || pagina > realizados.TotalPaginas)
        {
            return Task.CompletedTask;
        }

        return CargarRealizadosAsync(pagina);
    }

    /// <summary>
    /// Calcula qué números de página mostrar en la paginación (máximo 5 alrededor de la actual).
    /// </summary>
    private static IEnumerable<int> PaginasVisibles(int paginaActual, int totalPaginas)
    {
        if (totalPaginas <= 1)
        {
            yield return 1;
            yield break;
        }

        var inicio = Math.Max(1, paginaActual - 2);
        var fin = Math.Min(totalPaginas, inicio + 4);
        inicio = Math.Max(1, fin - 4);

        for (var numero = inicio; numero <= fin; numero++)
        {
            yield return numero;
        }
    }

    // =====================================================================
    // Catálogo
    // =====================================================================

    private void AbrirNuevoCatalogo()
    {
        errorModal = null;
        mensajeExito = null;
        catalogoForm = new TratamientoFormDto();
        mostrarModalCatalogo = true;
    }

    private async Task AbrirEditarCatalogoAsync(TratamientoListItemDto item)
    {
        errorPagina = null;
        errorModal = null;
        mensajeExito = null;

        try
        {
            var formulario = await TratamientoService.GetFormAsync(item.Id);
            if (formulario is null)
            {
                errorPagina = "El tratamiento seleccionado ya no existe.";
                return;
            }

            catalogoForm = formulario;
            mostrarModalCatalogo = true;
        }
        catch (Exception exception)
        {
            errorPagina = "No fue posible abrir el tratamiento seleccionado.";
            Console.Error.WriteLine(exception);
        }
    }

    private async Task GuardarCatalogoAsync()
    {
        errorModal = null;
        guardando = true;

        try
        {
            var esNuevo = catalogoForm.Id == 0;

            if (esNuevo)
            {
                await TratamientoService.CreateAsync(catalogoForm);
            }
            else
            {
                await TratamientoService.UpdateAsync(catalogoForm);
            }

            mostrarModalCatalogo = false;
            mensajeExito = esNuevo
                ? "Tratamiento creado correctamente."
                : "Tratamiento actualizado correctamente.";

            await CargarCatalogoAsync(esNuevo ? 1 : paginaCatalogo);
        }
        catch (InvalidOperationException exception)
        {
            errorModal = exception.Message;
        }
        catch (Exception exception)
        {
            errorModal = "No fue posible guardar el tratamiento. Intente nuevamente.";
            Console.Error.WriteLine(exception);
        }
        finally
        {
            guardando = false;
        }
    }

    // =====================================================================
    // Realizados: alta y edición
    // =====================================================================

    /// <summary>
    /// Abre el formulario de alta. Carga las opciones y verifica que existan
    /// pacientes, odontólogos y tratamientos activos antes de mostrarlo.
    /// </summary>
    private async Task AbrirNuevoRealizadoAsync()
    {
        errorPagina = null;
        errorModal = null;
        mensajeExito = null;

        try
        {
            await CargarOpcionesFormularioAsync();

            if (!pacientes.Any(paciente => paciente.Activo) ||
                !odontologos.Any(odontologo => odontologo.Activo) ||
                !tratamientos.Any(tratamiento => tratamiento.Activo))
            {
                errorPagina = "Para registrar un tratamiento necesita al menos un paciente, un odontólogo y un tratamiento activos.";
                return;
            }

            realizadoForm = new TratamientoRealizadoFormDto
            {
                Fecha = DateTime.Today
            };
            consultasPaciente = [];
            busquedaPaciente = string.Empty;
            mostrarModalRealizado = true;
        }
        catch (Exception exception)
        {
            errorPagina = "No fue posible cargar los datos del formulario.";
            Console.Error.WriteLine(exception);
        }
    }

    /// <summary>
    /// Abre el formulario de edición con los datos actuales del tratamiento realizado.
    /// </summary>
    private async Task EditarDesdeDetalleAsync()
    {
        if (detalle is null)
        {
            return;
        }

        var id = detalle.Id;
        mostrarDetalle = false;
        detalle = null;
        await AbrirEditarRealizadoAsync(id);
    }

    private async Task AbrirEditarRealizadoAsync(int id)
    {
        errorPagina = null;
        errorModal = null;
        mensajeExito = null;

        try
        {
            var formulario = await TratamientoService.GetRealizadoFormAsync(id);
            if (formulario is null)
            {
                errorPagina = "El tratamiento realizado ya no existe.";
                return;
            }

            await CargarOpcionesFormularioAsync();

            realizadoForm = formulario;
            consultasPaciente = (await TratamientoService.GetConsultasPacienteAsync(formulario.PacienteId)).ToList();
            busquedaPaciente = string.Empty;
            mostrarModalRealizado = true;
        }
        catch (InvalidOperationException exception)
        {
            errorPagina = exception.Message;
        }
        catch (Exception exception)
        {
            errorPagina = "No fue posible abrir el tratamiento realizado.";
            Console.Error.WriteLine(exception);
        }
    }

    private async Task CargarOpcionesFormularioAsync()
    {
        // Las consultas se piden una detrás de otra: comparten el mismo DbContext scoped.
        pacientes = (await TratamientoService.GetPacientesAsync()).ToList();
        odontologos = (await TratamientoService.GetOdontologosAsync()).ToList();
        tratamientos = (await TratamientoService.GetTratamientosAsync(soloActivos: false)).ToList();
        piezas = (await TratamientoService.GetPiezasAsync()).ToList();
    }

    /// <summary>
    /// Al cambiar de paciente se descarta la consulta elegida (pertenecía al paciente anterior)
    /// y se cargan las consultas del nuevo paciente.
    /// </summary>
    private async Task OnPacienteCambiadoAsync()
    {
        realizadoForm.ConsultaId = null;
        consultasPaciente = realizadoForm.PacienteId > 0
            ? (await TratamientoService.GetConsultasPacienteAsync(realizadoForm.PacienteId)).ToList()
            : [];
    }

    /// <summary>Autocompleta el precio con el precio base del tratamiento elegido.</summary>
    private void OnTratamientoSeleccionado()
    {
        var seleccionado = tratamientos.FirstOrDefault(tratamiento => tratamiento.Id == realizadoForm.TratamientoId);
        if (seleccionado is not null)
        {
            realizadoForm.Precio = seleccionado.PrecioBase;
        }
    }

    /// <summary>
    /// Guarda el tratamiento realizado (alta o edición). Los errores de negocio se muestran
    /// dentro del modal, que permanece abierto.
    /// </summary>
    private async Task GuardarRealizadoAsync()
    {
        errorModal = null;
        guardando = true;

        try
        {
            var esNuevo = realizadoForm.Id == 0;

            if (esNuevo)
            {
                await TratamientoService.CreateRealizadoAsync(realizadoForm);
            }
            else
            {
                await TratamientoService.UpdateRealizadoAsync(realizadoForm);
            }

            mostrarModalRealizado = false;
            mensajeExito = esNuevo
                ? "Tratamiento registrado correctamente."
                : "Tratamiento actualizado correctamente.";

            await CargarRealizadosAsync(esNuevo ? 1 : paginaRealizados);
        }
        catch (InvalidOperationException exception)
        {
            errorModal = exception.Message;
        }
        catch (Exception exception)
        {
            errorModal = "No fue posible guardar el tratamiento realizado. Intente nuevamente.";
            Console.Error.WriteLine(exception);
        }
        finally
        {
            guardando = false;
        }
    }

    // =====================================================================
    // Realizados: detalle y acciones de estado
    // =====================================================================

    private async Task VerDetalleAsync(int id)
    {
        errorPagina = null;
        mensajeExito = null;
        errorModal = null;
        exitoModal = null;

        try
        {
            detalle = await TratamientoService.GetRealizadoAsync(id);
            if (detalle is null)
            {
                errorPagina = "El tratamiento realizado ya no existe.";
                return;
            }

            mostrarDetalle = true;
        }
        catch (Exception exception)
        {
            errorPagina = "No fue posible cargar el detalle del tratamiento.";
            Console.Error.WriteLine(exception);
        }
    }

    private Task MarcarCompletadoDetalleAsync() => EjecutarAccionDetalleAsync(
        () => TratamientoService.MarcarCompletadoAsync(detalle!.Id),
        "Tratamiento marcado como completado.",
        "No se pudo marcar el tratamiento como completado.");

    private Task ReabrirDetalleAsync() => EjecutarAccionDetalleAsync(
        () => TratamientoService.ReabrirRealizadoAsync(detalle!.Id),
        "Tratamiento reabierto.",
        "No se pudo reabrir el tratamiento.");

    private async Task CancelarDetalleAsync()
    {
        if (detalle is null)
        {
            return;
        }

        // Confirmación explícita: cancelar no tiene deshacer.
        var confirmado = await JS.InvokeAsync<bool>(
            "confirm",
            "¿Cancelar este tratamiento? Esta acción no se puede deshacer.");

        if (!confirmado)
        {
            return;
        }

        await EjecutarAccionDetalleAsync(
            () => TratamientoService.CancelarRealizadoAsync(detalle!.Id),
            "Tratamiento cancelado correctamente.",
            "No fue posible cancelar el tratamiento. Intente nuevamente.");
    }

    /// <summary>
    /// Ejecuta una acción de estado sobre el detalle abierto, recarga el detalle y la tabla,
    /// y muestra el resultado dentro del modal.
    /// </summary>
    private async Task EjecutarAccionDetalleAsync(Func<Task> accion, string mensajeOk, string mensajeError)
    {
        if (detalle is null || guardandoAccion)
        {
            return;
        }

        guardandoAccion = true;
        errorModal = null;
        exitoModal = null;

        try
        {
            await accion();

            detalle = await TratamientoService.GetRealizadoAsync(detalle.Id);
            exitoModal = mensajeOk;

            await CargarRealizadosAsync();
        }
        catch (InvalidOperationException exception)
        {
            errorModal = exception.Message;
        }
        catch (Exception exception)
        {
            errorModal = mensajeError;
            Console.Error.WriteLine(exception);
        }
        finally
        {
            guardandoAccion = false;
        }
    }

    /// <summary>
    /// Cierra cualquier modal abierto. No se cierra mientras hay una operación en curso.
    /// </summary>
    private void CerrarModales()
    {
        if (guardando || guardandoAccion)
        {
            return;
        }

        mostrarModalCatalogo = false;
        mostrarModalRealizado = false;
        mostrarDetalle = false;
        detalle = null;
        errorModal = null;
        exitoModal = null;
    }

    private void CerrarErrorPagina() => errorPagina = null;

    // =====================================================================
    // Utilidades
    // =====================================================================

    /// <summary>
    /// Normaliza texto para búsqueda: sin tildes y en minúsculas.
    /// </summary>
    private static string Normalizar(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
        {
            return string.Empty;
        }

        var descompuesto = texto.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(descompuesto.Length);
        foreach (var c in descompuesto)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                sb.Append(c);
            }
        }

        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC).ToLowerInvariant();
    }
}
