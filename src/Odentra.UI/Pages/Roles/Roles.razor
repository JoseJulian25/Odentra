@page "/roles"
@attribute [Authorize(Policy = "Roles.Ver")]
@using Odentra.Services.Autorizacion
@inject IRolService RolService

<PageTitle>Roles y permisos · Odentra</PageTitle>

<div class="roles-page">
    <header class="roles-header">
        <div>
            <span class="page-eyebrow">Administración</span>
            <h1>Roles y permisos</h1>
            <p>Define qué acciones puede realizar cada rol dentro del sistema.</p>
        </div>

        <div class="header-actions">
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <span class="save-hint">✓ @successMessage</span>
            }

            <AuthorizeView Policy="Roles.Editar">
                <Authorized>
                    <button type="button" class="primary-action" @onclick="SavePermissionsAsync"
                            disabled="@(saving || selectedRole is null)">
                        @(saving ? "Guardando..." : "Guardar cambios")
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="feedback error" role="alert">@errorMessage</div>
    }

    @if (loading)
    {
        <div class="roles-state">Cargando roles y permisos...</div>
    }
    else if (roles.Count == 0)
    {
        <div class="roles-state">No hay roles configurados.</div>
    }
    else
    {
        <div class="role-tabs" role="tablist" aria-label="Roles disponibles">
            @foreach (var role in roles)
            {
                <button type="button" role="tab"
                        aria-selected="@(selectedRole?.Id == role.Id ? "true" : "false")"
                        class="role-tab @(selectedRole?.Id == role.Id ? "active" : "")"
                        @onclick="() => SelectRole(role)">
                    <span class="role-badge @GetRoleBadgeClass(role.Nombre)">@role.Nombre</span>
                </button>
            }
        </div>

        @if (selectedRole is not null)
        {
            <section class="permissions-card">
                <div class="permissions-card-header">
                    <div>
                        <h3>
                            Permisos del rol:
                            <span class="role-badge @GetRoleBadgeClass(selectedRole.Nombre)">@selectedRole.Nombre</span>
                        </h3>
                        @if (IsAdmin)
                        {
                            <p>El rol Administrador tiene acceso completo al sistema.</p>
                        }
                    </div>
                </div>

                <div class="permissions-table-wrap">
                    <table class="permissions-table">
                        <thead>
                            <tr>
                                <th class="module-col">Módulo</th>
                                @foreach (var action in actions)
                                {
                                    <th class="perm-col">@action</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < modules.Count; i++)
                            {
                                var module = modules[i];
                                <tr class="@(i % 2 == 0 ? "row-even" : "row-odd")">
                                    <td class="module-cell">@module</td>
                                    @foreach (var action in actions)
                                    {
                                        var permissionName = GetPermissionName(module, action);
                                        <td class="perm-cell">
                                            @if (permissionName is null)
                                            {
                                                <span class="perm-empty">—</span>
                                            }
                                            else
                                            {
                                                <input type="checkbox"
                                                       class="perm-check"
                                                       checked="@selectedPermissions.Contains(permissionName)"
                                                       disabled="@(IsAdmin || IsMandatory(permissionName))"
                                                       @onchange="eventArgs => TogglePermission(permissionName, eventArgs.Value is true)" />
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@code {
    private static readonly string[] OrdenAcciones =
        ["Ver", "Crear", "Editar", "Desactivar", "Cancelar", "Atender", "Registrar", "Exportar"];

    private List<RolePermissionDto> roles = [];
    private List<PermissionDefinition> permissions = [];
    private List<string> modules = [];
    private List<string> actions = [];
    private Dictionary<(string Modulo, string Accion), string> permissionNames = [];
    private RolePermissionDto? selectedRole;
    private HashSet<string> selectedPermissions = new(StringComparer.Ordinal);
    private bool loading = true;
    private bool saving;
    private string? errorMessage;
    private string? successMessage;

    private bool IsAdmin => selectedRole?.Nombre == RolesOdentra.Administrador;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            roles = (await RolService.GetRolesAsync()).ToList();
            permissions = (await RolService.GetPermissionsAsync()).ToList();
            BuildPermissionMatrix();
            SelectRole(roles.FirstOrDefault());
        }
        catch (Exception)
        {
            errorMessage = "No fue posible cargar los roles y permisos.";
        }
        finally
        {
            loading = false;
        }
    }

    private void BuildPermissionMatrix()
    {
        modules = permissions
            .Select(permission => permission.Modulo)
            .Distinct(StringComparer.Ordinal)
            .ToList();

        actions = permissions
            .Select(permission => ObtenerAccion(permission.Nombre))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(IndiceAccion)
            .ThenBy(action => action, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        permissionNames = permissions.ToDictionary(
            permission => (permission.Modulo, ObtenerAccion(permission.Nombre)),
            permission => permission.Nombre);
    }

    private void SelectRole(RolePermissionDto? role)
    {
        selectedRole = role;
        selectedPermissions = role is null
            ? new HashSet<string>(StringComparer.Ordinal)
            : role.Permisos.ToHashSet(StringComparer.Ordinal);
        successMessage = null;
        errorMessage = null;
    }

    private void TogglePermission(string permission, bool selected)
    {
        if (IsMandatory(permission)) return;

        if (selected) selectedPermissions.Add(permission);
        else selectedPermissions.Remove(permission);
    }

    private bool IsMandatory(string permission) =>
        selectedRole?.Nombre == RolesOdentra.Administrador
        && (permission == "Roles.Ver" || permission == "Roles.Editar");

    private string? GetPermissionName(string module, string action) =>
        permissionNames.TryGetValue((module, action), out var permission) ? permission : null;

    private async Task SavePermissionsAsync()
    {
        if (selectedRole is null) return;
        saving = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var roleId = selectedRole.Id;
            await RolService.UpdatePermissionsAsync(roleId, selectedPermissions);
            roles = (await RolService.GetRolesAsync()).ToList();
            selectedRole = roles.First(role => role.Id == roleId);
            selectedPermissions = selectedRole.Permisos.ToHashSet(StringComparer.Ordinal);
            successMessage = "Cambios guardados";
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private static string ObtenerAccion(string permissionName)
    {
        var separator = permissionName.IndexOf('.');
        return separator >= 0 && separator < permissionName.Length - 1
            ? permissionName[(separator + 1)..]
            : permissionName;
    }

    private static int IndiceAccion(string action)
    {
        var index = Array.IndexOf(OrdenAcciones, action);
        return index >= 0 ? index : int.MaxValue;
    }

    private static string GetRoleBadgeClass(string roleName) => roleName switch
    {
        RolesOdentra.Administrador => "role-badge-danger",
        RolesOdentra.Recepcionista => "role-badge-success",
        RolesOdentra.Odontologo => "role-badge-info",
        _ => "role-badge-neutral"
    };
}
