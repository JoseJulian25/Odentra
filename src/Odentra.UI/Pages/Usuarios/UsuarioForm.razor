@page "/usuarios/nuevo"
@page "/usuarios/editar/{Id}"
@attribute [Authorize(Policy = "Usuarios.Editar")]
@using Odentra.Data.Entities
@using Odentra.Services.Usuarios
@using Odentra.Services.Usuarios.DTOs
@inject IUsuarioService UsuarioService
@inject NavigationManager Navigation

<PageTitle>@(IsEditing ? "Editar usuario" : "Registrar usuario") · Odentra</PageTitle>

<div class="user-form-page">
    <header class="form-header">
        <a class="back-link" href="/usuarios">← Volver a usuarios</a>
        <span class="page-eyebrow">Administración de acceso</span>
        <h1>@(IsEditing ? "Editar usuario" : "Registrar usuario")</h1>
        <p>@(IsEditing ? "Actualiza la cuenta, el estado y los roles del usuario." : "Crea una cuenta con acceso al sistema.")</p>
    </header>

    @if (loading)
    {
        <div class="form-state">Cargando información...</div>
    }
    else if (notFound)
    {
        <div class="form-state">El usuario no existe.</div>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="feedback error">@errorMessage</div>
            }

            <section class="form-panel">
                <div class="section-heading">
                    <div><span class="section-kicker">01</span><h2>Información de la cuenta</h2></div>
                    <span>Datos básicos de acceso</span>
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label for="user-name">Nombre completo</label>
                        <InputText id="user-name" @bind-Value="model.Nombre" placeholder="Ej. Ana Rodríguez" />
                        <ValidationMessage For="@(() => model.Nombre)" />
                    </div>
                    <div class="field">
                        <label for="user-email">Correo electrónico</label>
                        <InputText id="user-email" type="email" @bind-Value="model.Email" placeholder="usuario@clinica.com" />
                        <ValidationMessage For="@(() => model.Email)" />
                    </div>
                    <div class="field field-wide">
                        <label for="user-password">@(IsEditing ? "Nueva contraseña (opcional)" : "Contraseña inicial")</label>
                        <InputText id="user-password" type="password" @bind-Value="model.Password" placeholder="••••••••" />
                        <small class="field-help">Mínimo 8 caracteres, una mayúscula y un número.</small>
                    </div>
                    @if (IsEditing)
                    {
                        <div class="field">
                            <span class="field-label">Estado de la cuenta</span>
                            <label class="checkbox-line">
                                <input type="checkbox" @bind="IsUserActive" />
                                <span>Activo</span>
                            </label>
                        </div>
                    }
                </div>
            </section>

            <section class="form-panel">
                <div class="section-heading">
                    <div><span class="section-kicker">02</span><h2>Roles y permisos base</h2></div>
                    <span>Selecciona al menos uno</span>
                </div>
                <div class="roles-grid">
                    @foreach (var role in availableRoles)
                    {
                        <label class="role-option">
                            <input type="checkbox" checked="@model.Roles.Contains(role)" @onchange="eventArgs => ToggleRole(role, eventArgs.Value is true)" />
                            <span class="role-copy"><strong>@role</strong><small>@GetRoleDescription(role)</small></span>
                        </label>
                    }
                </div>
            </section>

            <div class="form-actions">
                <a class="cancel-action" href="/usuarios">Cancelar</a>
                <button class="primary-action" type="submit" disabled="@saving">
                    @(saving ? "Guardando..." : "Guardar usuario")
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    private UsuarioFormDto model = new();
    private List<string> availableRoles = [];
    private bool loading = true;
    private bool saving;
    private bool notFound;
    private string? errorMessage;

    private bool IsEditing => !string.IsNullOrWhiteSpace(Id);

    private bool IsUserActive
    {
        get => model.Estado == EstadoRegistro.Activo;
        set => model.Estado = value ? EstadoRegistro.Activo : EstadoRegistro.Inactivo;
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        availableRoles = (await UsuarioService.GetAvailableRolesAsync()).ToList();

        if (IsEditing)
        {
            var loaded = await UsuarioService.GetFormAsync(Id!);
            if (loaded is null)
            {
                notFound = true;
            }
            else
            {
                model = loaded;
            }
        }

        loading = false;
    }

    private void ToggleRole(string role, bool selected)
    {
        if (selected && !model.Roles.Contains(role))
        {
            model.Roles.Add(role);
        }

        if (!selected)
        {
            model.Roles.Remove(role);
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        errorMessage = null;

        if (!IsEditing && string.IsNullOrWhiteSpace(model.Password))
        {
            errorMessage = "La contraseña inicial es obligatoria.";
            saving = false;
            return;
        }

        if (model.Roles.Count == 0)
        {
            errorMessage = "Selecciona al menos un rol.";
            saving = false;
            return;
        }

        try
        {
            if (IsEditing)
            {
                await UsuarioService.UpdateAsync(model);
            }
            else
            {
                await UsuarioService.CreateAsync(model);
            }

            Navigation.NavigateTo("/usuarios");
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private static string GetRoleDescription(string role) => role switch
    {
        "Administrador" => "Configuración y administración general",
        "Recepcionista" => "Pacientes, citas y pagos",
        "Odontólogo" => "Atención y gestión clínica",
        _ => "Permisos definidos para este rol"
    };
}
