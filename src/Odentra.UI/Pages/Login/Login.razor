@page "/login"
@layout LoginLayout

<PageTitle>Iniciar sesión · Odentra</PageTitle>

<div class="login-form-wrap">
    <div class="mobile-login-brand">
        <div class="brand-mark">+</div>
        <strong>Odentra</strong>
    </div>

    <h1>Iniciar sesión</h1>
    <p class="login-subtitle">Ingrese sus credenciales para acceder al sistema.</p>

    <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <div class="form-field">
            <label for="email">Correo electrónico</label>
            <InputText id="email" @bind-Value="loginModel.Email" type="email" placeholder="correo@clinica.com" />
            <ValidationMessage For="@(() => loginModel.Email)" />
        </div>
        <div class="form-field">
            <div class="field-label-row">
                <label for="password">Contraseña</label>
                <a href="/login">¿Olvidó su contraseña?</a>
            </div>
            <InputText id="password" @bind-Value="loginModel.Password" type="password" placeholder="••••••••" />
            <ValidationMessage For="@(() => loginModel.Password)" />
        </div>
        <button class="login-submit" type="submit">Ingresar</button>
    </EditForm>

    <div class="login-demo"><strong>Demo:</strong> admin@odentra.com / cualquier contraseña</div>
</div>

@code {
    private LoginModel loginModel = new() { Email = "admin@odentra.com" };

    private void HandleLogin()
    {
        Navigation.NavigateTo("/");
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Introduzca un correo válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;
    }
}