@page "/pacientes/{Id:int}"
@using Odentra.Data.Entities
@using Odentra.Services.Pacientes
@using Odentra.Services.Pacientes.DTOs
@inject IPacienteService PacienteService
@inject NavigationManager Navigation

<PageTitle>Paciente · Odentra</PageTitle>

<div class="patient-detail-page">
    @if (loading)
    {
        <div class="detail-state">Cargando paciente...</div>
    }
    else if (patient is null)
    {
        <div class="detail-state"><strong>Paciente no encontrado</strong><a href="/pacientes">Volver a pacientes</a></div>
    }
    else
    {
        <div class="page-header"><div><a class="back-link" href="/pacientes">← Pacientes</a><div class="title-line"><h1>@patient.Nombres @patient.Apellidos</h1><span class="status-badge @(patient.Estado == EstadoRegistro.Activo ? "active" : "inactive")">@patient.Estado</span></div><p>Paciente registrado el @patient.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy")</p></div><div class="header-actions"><a class="secondary-action" href="/pacientes/editar/@patient.Id">Editar</a><button class="@(patient.Estado == EstadoRegistro.Activo ? "danger-action" : "primary-action")" @onclick="ToggleStatusAsync">@(patient.Estado == EstadoRegistro.Activo ? "Desactivar" : "Activar")</button></div></div>
        @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="feedback error">@errorMessage</div> }
        <section class="detail-panel"><div class="section-heading"><h2>Información personal</h2></div><dl class="detail-grid"><div><dt>Identificación</dt><dd>@(patient.Identificacion ?? "No registrada")</dd></div><div><dt>Fecha de nacimiento</dt><dd>@(patient.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No registrada")</dd></div><div><dt>Sexo</dt><dd>@(patient.Sexo ?? "No registrado")</dd></div></dl></section>
        <section class="detail-panel"><div class="section-heading"><h2>Información de contacto</h2></div><dl class="detail-grid"><div><dt>Teléfono</dt><dd>@(patient.Telefono ?? "No registrado")</dd></div><div><dt>Correo electrónico</dt><dd>@(patient.Correo ?? "No registrado")</dd></div><div class="detail-wide"><dt>Dirección</dt><dd>@(patient.Direccion ?? "No registrada")</dd></div></dl></section>
        <section class="detail-panel"><div class="section-heading"><h2>Contacto de emergencia</h2></div><dl class="detail-grid"><div><dt>Nombre</dt><dd>@(patient.ContactoEmergenciaNombre ?? "No registrado")</dd></div><div><dt>Teléfono</dt><dd>@(patient.ContactoEmergenciaTelefono ?? "No registrado")</dd></div><div><dt>Relación</dt><dd>@(patient.ContactoEmergenciaRelacion ?? "No registrada")</dd></div></dl></section>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private PacienteDetalleDto? patient;
    private bool loading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        patient = await PacienteService.GetByIdAsync(Id);
        loading = false;
    }

    private async Task ToggleStatusAsync()
    {
        if (patient is null) return;
        errorMessage = null;
        try
        {
            var nextStatus = patient.Estado == EstadoRegistro.Activo ? EstadoRegistro.Inactivo : EstadoRegistro.Activo;
            await PacienteService.SetStatusAsync(patient.Id, nextStatus);
            patient = await PacienteService.GetByIdAsync(patient.Id);
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
    }
}