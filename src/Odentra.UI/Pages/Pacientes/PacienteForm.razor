@page "/pacientes/nuevo"
@page "/pacientes/editar/{Id:int}"
@using Odentra.Data.Entities
@using Odentra.Services.Pacientes
@using Odentra.Services.Pacientes.DTOs
@inject IPacienteService PacienteService
@inject NavigationManager Navigation

<PageTitle>@(IsEditing ? "Editar paciente" : "Registrar paciente") · Odentra</PageTitle>

<div class="patient-form-page">
    <div class="page-header"><div><a class="back-link" href="/pacientes">← Pacientes</a><h1>@(IsEditing ? "Editar paciente" : "Registrar paciente")</h1><p>@(IsEditing ? "Actualiza la información administrativa del paciente." : "Registra la información general del paciente.")</p></div></div>
    @if (loading)
    {
        <div class="form-state">Cargando información...</div>
    }
    else if (notFound)
    {
        <div class="form-state">El paciente solicitado no existe.</div>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="feedback error">@errorMessage</div> }
            <section class="form-panel"><div class="section-heading"><h2>Información personal</h2><span>Campos obligatorios marcados en el formulario</span></div><div class="form-grid"><div class="field"><label for="first-name">Nombres</label><InputText id="first-name" @bind-Value="model.Nombres" /><ValidationMessage For="@(() => model.Nombres)" /></div><div class="field"><label for="last-name">Apellidos</label><InputText id="last-name" @bind-Value="model.Apellidos" /><ValidationMessage For="@(() => model.Apellidos)" /></div><div class="field"><label for="identification">Identificación</label><InputText id="identification" @bind-Value="model.Identificacion" /><ValidationMessage For="@(() => model.Identificacion)" /></div><div class="field"><label for="birth-date">Fecha de nacimiento</label><InputDate id="birth-date" @bind-Value="model.FechaNacimiento" /></div><div class="field"><label for="sex">Sexo</label><InputSelect id="sex" @bind-Value="model.Sexo"><option value="">Seleccionar</option><option value="Femenino">Femenino</option><option value="Masculino">Masculino</option><option value="Otro">Otro</option></InputSelect></div></div></section>
            <section class="form-panel"><div class="section-heading"><h2>Información de contacto</h2></div><div class="form-grid"><div class="field"><label for="phone">Teléfono</label><InputText id="phone" @bind-Value="model.Telefono" /><ValidationMessage For="@(() => model.Telefono)" /></div><div class="field"><label for="email">Correo electrónico</label><InputText id="email" type="email" @bind-Value="model.Correo" /><ValidationMessage For="@(() => model.Correo)" /></div><div class="field field-wide"><label for="address">Dirección</label><InputText id="address" @bind-Value="model.Direccion" /></div></div></section>
            <section class="form-panel"><div class="section-heading"><h2>Contacto de emergencia</h2></div><div class="form-grid"><div class="field"><label for="emergency-name">Nombre</label><InputText id="emergency-name" @bind-Value="model.ContactoEmergenciaNombre" /></div><div class="field"><label for="emergency-phone">Teléfono</label><InputText id="emergency-phone" @bind-Value="model.ContactoEmergenciaTelefono" /></div><div class="field"><label for="emergency-relation">Relación</label><InputText id="emergency-relation" @bind-Value="model.ContactoEmergenciaRelacion" /></div></div></section>
            @if (IsEditing) { <div class="status-checkbox"><label><input type="checkbox" @bind="IsPatientActive" /> <span>Activo</span></label></div> }
            <div class="form-actions"><a class="cancel-action" href="/pacientes">Cancelar</a><button class="primary-action" type="submit" disabled="@saving">@(saving ? "Guardando..." : "Guardar paciente")</button></div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private PacienteFormDto model = new();
    private bool loading;
    private bool saving;
    private bool notFound;
    private string? errorMessage;
    private bool IsEditing => Id.HasValue;
    private bool IsPatientActive
    {
        get => model.Estado == EstadoRegistro.Activo;
        set => model.Estado = value ? EstadoRegistro.Activo : EstadoRegistro.Inactivo;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Id.HasValue) return;
        loading = true;
        var loaded = await PacienteService.GetFormAsync(Id.Value);
        if (loaded is null) notFound = true;
        else model = loaded;
        loading = false;
    }

    private async Task SaveAsync()
    {
        saving = true;
        errorMessage = null;
        try
        {
            if (IsEditing) await PacienteService.UpdateAsync(model);
            else model.Id = await PacienteService.CreateAsync(model);
            Navigation.NavigateTo($"/pacientes/{model.Id}");
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally { saving = false; }
    }
}