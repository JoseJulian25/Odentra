            padding: 12px 20px;
            font-size: 11px;
            font-weight: 700;
            color: #64748B;
            letter-spacing: 0.05em;
        }

        .custom-table td {
            padding: 14px 20px;
            border-bottom: 1px solid #F1F5F9;
            color: #334155;
        }

        .custom-table tr:hover {
            background-color: #F8FAFC;
        }

    .col-main {
        font-weight: 600;
        color: #1E293B;
    }

    .col-desc {
        color: #64748B;
    }

    .col-price {
        font-weight: 700;
        color: #1E293B;
    }

    .col-date, .col-tooth {
        color: #475569;
    }

    .status-active {
        color: #16A34A;
        font-weight: 600;
        font-size: 13px;
    }

    .status-inactive {
        color: #94A3B8;
        font-weight: 500;
        font-size: 13px;
    }

    .badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 9999px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-completado {
        background-color: #DCFCE7;
        color: #15803D;
    }

    .badge-proceso {
        background-color: #DBEAFE;
        color: #1D4ED8;
    }

    .badge-pendiente {
        background-color: #FEF3C7;
        color: #B45309;
    }

    .badge-cancelado {
        background-color: #FEE2E2;
        color: #B91C1C;
    }

    .btn-action {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        border-radius: 6px;
        color: #94A3B8;
    }

        .btn-action:hover {
            color: #2563EB;
            background-color: #F1F5F9;
        }

    .action-icon {
        width: 16px;
        height: 16px;
    }

    .table-footer {
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        color: #64748B;
        border-top: 1px solid #F1F5F9;
    }

    .pagination-indicator {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background-color: #F1F5F9;
        color: #1E293B;
        font-weight: 600;
    }

    .empty-state {
        text-align: center;
        padding: 48px;
        color: #94A3B8;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background-color: rgba(15, 23, 42, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-card {
        background: #FFFFFF;
        border-radius: 14px;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .modal-header {
        padding: 18px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #F1F5F9;
    }

    .modal-title {
        font-size: 18px;
        font-weight: 700;
        color: #1E293B;
        margin: 0;
    }

    .modal-close-btn {
        background: none;
        border: none;
        font-size: 24px;
        color: #94A3B8;
        cursor: pointer;
        line-height: 1;
    }

    .modal-body {
        padding: 20px 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #475569;
    }

    .form-control {
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        padding: 9px 12px;
        font-size: 14px;
        color: #1E293B;
        outline: none;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: #2563EB;
        }

    .resize-none {
        resize: none;
    }

    .modal-footer {
        padding: 16px 24px;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        border-top: 1px solid #F1F5F9;
        background-color: #F8FAFC;
    }

    .btn-cancel {
        background: #FFFFFF;
        border: 1px solid #CBD5E1;
        color: #475569;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
    }

    .alert-error {
        background-color: #FEE2E2;
        color: #B91C1C;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 13px;
        margin: 12px 24px 0 24px;
    }
</style>

@code {
    private string pestañaActiva = "catalogo";
    private string busqueda = "";
    private string filtroEstado = "Todos";
    private bool cargando = true;

    private List<Tratamiento> listaTratamientos = new();
    private List<Tratamiento> tratamientosFiltrados = new();

    private List<TratamientoRealizado> listaRealizados = new();
    private List<TratamientoRealizado> realizadosFiltrados = new();

    private List<Paciente> pacientes = new();
    private List<Odontologo> odontologos = new();
    private List<PiezaDental> piezasDentales = new();

    private bool mostrarModalCatalogo = false;
    private bool mostrarModalRealizado = false;
    private string? errorModal;

    private Tratamiento tratamientoEditando = new();
    private TratamientoRealizado nuevoRealizado = new();
    private string piezaDentalSeleccionadaStr = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            listaTratamientos = await DbContext.Tratamientos
                .AsNoTracking()
                .OrderBy(t => t.Nombre)
                .ToListAsync();

            listaRealizados = await DbContext.TratamientosRealizados
                .Include(tr => tr.Paciente)
                .Include(tr => tr.Tratamiento)
                .Include(tr => tr.Odontologo)
                .Include(tr => tr.PiezaDental)
                .AsNoTracking()
                .OrderByDescending(tr => tr.Fecha)
                .ToListAsync();

            pacientes = await DbContext.Pacientes.AsNoTracking().ToListAsync();
            odontologos = await DbContext.Odontologos.AsNoTracking().ToListAsync();

            try
            {
                piezasDentales = await DbContext.PiezasDentales.AsNoTracking().OrderBy(p => p.Id).ToListAsync();
            }
            catch
            {
                piezasDentales = new();
            }

            FiltrarDatos();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void CambiarPestaña(string pestaña)
    {
        pestañaActiva = pestaña;
        busqueda = "";
        filtroEstado = "Todos";
        FiltrarDatos();
    }

    private void FiltrarDatos()
    {
        var term = busqueda.Trim().ToLower();

        if (pestañaActiva == "catalogo")
        {
            tratamientosFiltrados = listaTratamientos.Where(t =>
            {
                var coincideTexto = string.IsNullOrWhiteSpace(term) ||
                                    t.Nombre.ToLower().Contains(term) ||
                                    (t.Descripcion != null && t.Descripcion.ToLower().Contains(term));

                var coincideEstado = filtroEstado switch
                {
                    "Activo" => t.Estado == EstadoRegistro.Activo,
                    "Inactivo" => t.Estado == EstadoRegistro.Inactivo,
                    _ => true
                };

                return coincideTexto && coincideEstado;
            }).ToList();
        }
        else
        {
            realizadosFiltrados = listaRealizados.Where(r =>
            {
                var pacienteNombre = r.Paciente != null ? $"{r.Paciente.Nombres} {r.Paciente.Apellidos}".ToLower() : "";
                var tratamientoNombre = r.Tratamiento != null ? r.Tratamiento.Nombre.ToLower() : "";

                var coincideTexto = string.IsNullOrWhiteSpace(term) ||
                                    pacienteNombre.Contains(term) ||
                                    tratamientoNombre.Contains(term);

                var coincideEstado = filtroEstado switch
                {
                    "Completado" => r.Estado == EstadoTratamiento.Completado,
                    "En proceso" => r.Estado == EstadoTratamiento.EnProceso,
                    "Pendiente" => r.Estado == EstadoTratamiento.Pendiente,
                    "Cancelado" => r.Estado == EstadoTratamiento.Cancelado,
                    _ => true
                };

                return coincideTexto && coincideEstado;
            }).ToList();
        }
    }

    private void AbrirModalNuevoCatalogo()
    {
        tratamientoEditando = new Tratamiento { Estado = EstadoRegistro.Activo, PrecioBase = 0 };
        errorModal = null;
        mostrarModalCatalogo = true;
    }

    private void EditarTratamiento(Tratamiento item)
    {
        tratamientoEditando = new Tratamiento
        {
            Id = item.Id,
            Nombre = item.Nombre,
            Descripcion = item.Descripcion,
            PrecioBase = item.PrecioBase,
            Estado = item.Estado
        };
        errorModal = null;
        mostrarModalCatalogo = true;
    }

    private async Task GuardarTratamientoCatalogo()
    {
        if (string.IsNullOrWhiteSpace(tratamientoEditando.Nombre))
        {
            errorModal = "El nombre del tratamiento es obligatorio.";
            return;
        }

        if (tratamientoEditando.PrecioBase <= 0)
        {
            errorModal = "El precio base debe ser mayor a 0.";
            return;
        }

        try
        {
            if (tratamientoEditando.Id == 0)
            {
                DbContext.Tratamientos.Add(tratamientoEditando);
            }
            else
            {
                var entidad = await DbContext.Tratamientos.FindAsync(tratamientoEditando.Id);
                if (entidad != null)
                {
                    entidad.Nombre = tratamientoEditando.Nombre;
                    entidad.Descripcion = tratamientoEditando.Descripcion;
                    entidad.PrecioBase = tratamientoEditando.PrecioBase;
                    entidad.Estado = tratamientoEditando.Estado;
                }
            }

            await DbContext.SaveChangesAsync();
            mostrarModalCatalogo = false;
            await CargarDatos();
        }
        catch (Exception ex)
        {
            var msg = ex.InnerException != null ? ex.InnerException.Message : ex.Message;
            errorModal = $"Error al guardar: {msg}";
        }
    }

    private void AbrirModalRegistrarRealizado()
    {
        nuevoRealizado = new TratamientoRealizado
        {
            Fecha = DateTime.UtcNow,
            Estado = EstadoTratamiento.Pendiente,
            Precio = 0
        };
        piezaDentalSeleccionadaStr = "";
        errorModal = null;
        mostrarModalRealizado = true;
    }

    private void OnTratamientoSeleccionado()
    {
        var seleccionado = listaTratamientos.FirstOrDefault(t => t.Id == nuevoRealizado.TratamientoId);
        if (seleccionado != null)
        {
            nuevoRealizado.Precio = seleccionado.PrecioBase;
        }
    }

    private async Task GuardarTratamientoRealizado()
    {
        if (nuevoRealizado.PacienteId <= 0)
        {
            errorModal = "Debe seleccionar un paciente.";
            return;
        }

        if (nuevoRealizado.TratamientoId <= 0)
        {
            errorModal = "Debe seleccionar un tratamiento.";
            return;
        }

        if (nuevoRealizado.OdontologoId <= 0)
        {
            errorModal = "Debe seleccionar un odontólogo.";
            return;
        }

        if (int.TryParse(piezaDentalSeleccionadaStr, out int idPieza) && idPieza > 0)
        {
            nuevoRealizado.PiezaDentalId = idPieza;
        }
        else
        {
            nuevoRealizado.PiezaDentalId = null;
        }

        try
        {
            DbContext.TratamientosRealizados.Add(nuevoRealizado);
            await DbContext.SaveChangesAsync();
            mostrarModalRealizado = false;
            await CargarDatos();
        }
        catch (Exception ex)
        {
            var msg = ex.InnerException != null ? ex.InnerException.Message : ex.Message;
            errorModal = $"Error al registrar: {msg}";
        }
    }

    private void CerrarModales()
    {
        mostrarModalCatalogo = false;
        mostrarModalRealizado = false;
    }
}