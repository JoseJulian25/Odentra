@page "/tratamientos"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Odentra.Data
@using Odentra.Data.Entities
@inject ApplicationDbContext DbContext

<PageTitle>Tratamientos - Odentra</PageTitle>

<div class="tratamientos-container">
    <!-- Encabezado con Título y Botón Principal -->
    <div class="top-header">
        <h1 class="page-title">Tratamientos</h1>
        @if (pestañaActiva == "catalogo")
        {
            <button class="btn-primary" @onclick="AbrirModalNuevoCatalogo">
                <span class="icon-plus">+</span> Nuevo tratamiento
            </button>
        }
        else
        {
            <button class="btn-primary" @onclick="AbrirModalRegistrarRealizado">
                <span class="icon-plus">+</span> Registrar tratamiento
            </button>
        }
    </div>

    <!-- Pestañas Horizontales: Catálogo y Realizados -->
    <div class="tabs-container">
        <button class="tab-button @(pestañaActiva == "catalogo" ? "active" : "")"
                @onclick='() => CambiarPestaña("catalogo")'>
            Catálogo
        </button>
        <button class="tab-button @(pestañaActiva == "realizados" ? "active" : "")"
                @onclick='() => CambiarPestaña("realizados")'>
            Realizados
        </button>
    </div>

    <!-- Barra de Filtros (Buscador y Estado) -->
    <div class="filter-card">
        <div class="search-box">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="11" cy="11" r="8" stroke-width="2" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2" />
            </svg>
            <input type="text"
                   @bind="busqueda"
                   @bind:event="oninput"
                   @bind:after="FiltrarDatos"
                   placeholder="@(pestañaActiva == "catalogo" ? "Buscar tratamiento..." : "Buscar paciente o tratamiento...")"
                   class="search-input" />
        </div>

        <div class="status-select-container">
            <select @bind="filtroEstado" @bind:after="FiltrarDatos" class="status-select">
                <option value="Todos">Todos</option>
                @if (pestañaActiva == "catalogo")
                {
                    <option value="Activo">Activo</option>
                    <option value="Inactivo">Inactivo</option>
                }
                else
                {
                    <option value="Completado">Completado</option>
                    <option value="En proceso">En proceso</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Cancelado">Cancelado</option>
                }
            </select>
        </div>
    </div>

    <!-- CONTENIDO PESTAÑA 1: CATÁLOGO -->
    @if (pestañaActiva == "catalogo")
    {
        <div class="table-card">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 25%;">TRATAMIENTO</th>
                        <th style="width: 40%;">DESCRIPCIÓN</th>
                        <th style="width: 15%;">PRECIO BASE</th>
                        <th style="width: 10%;">ESTADO</th>
                        <th style="width: 10%; text-align: center;">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr>
                            <td colspan="5" class="empty-state">Cargando catálogo...</td>
                        </tr>
                    }
                    else if (!tratamientosFiltrados.Any())
                    {
                        <tr>
                            <td colspan="5" class="empty-state">No hay tratamientos para mostrar.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in tratamientosFiltrados)
                        {
                            <tr>
                                <td class="col-main">@item.Nombre</td>
                                <td class="col-desc">@(string.IsNullOrEmpty(item.Descripcion) ? "—" : item.Descripcion)</td>
                                <td class="col-price">RD$@item.PrecioBase.ToString("N2")</td>
                                <td>
                                    @if (item.Estado == EstadoRegistro.Activo)
                                    {
                                        <span class="status-active">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="status-inactive">Inactivo</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <button class="btn-action" title="Editar" @onclick="() => EditarTratamiento(item)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="action-icon">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <div class="table-footer">
                <span>@tratamientosFiltrados.Count registros</span>
                <span class="pagination-indicator">1</span>
            </div>
        </div>
    }

    <!-- CONTENIDO PESTAÑA 2: REALIZADOS -->
    @if (pestañaActiva == "realizados")
    {
        <div class="table-card">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 18%;">PACIENTE</th>
                        <th style="width: 20%;">TRATAMIENTO</th>
                        <th style="width: 16%;">ODONTÓLOGO</th>
                        <th style="width: 12%;">FECHA</th>
                        <th style="width: 10%;">PIEZA</th>
                        <th style="width: 12%;">PRECIO</th>
                        <th style="width: 8%;">ESTADO</th>
                        <th style="width: 4%; text-align: center;">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr>
                            <td colspan="8" class="empty-state">Cargando tratamientos realizados...</td>
                        </tr>
                    }
                    else if (!realizadosFiltrados.Any())
                    {
                        <tr>
                            <td colspan="8" class="empty-state">No hay tratamientos realizados registrados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in realizadosFiltrados)
                        {
                            <tr>
                                <td class="col-main">@(r.Paciente != null ? $"{r.Paciente.Nombres} {r.Paciente.Apellidos}" : $"Paciente #{r.PacienteId}")</td>
                                <td>@(r.Tratamiento != null ? r.Tratamiento.Nombre : $"Tratamiento #{r.TratamientoId}")</td>
                                <td class="col-desc">@(r.Odontologo != null ? $"{r.Odontologo.Nombres} {r.Odontologo.Apellidos}" : $"Dr. #{r.OdontologoId}")</td>
                                <td class="col-date">@r.Fecha.ToString("yyyy-MM-dd")</td>
                                <td class="col-tooth">@(r.PiezaDental != null ? r.PiezaDental.Nombre : (r.PiezaDentalId.HasValue ? $"Pieza #{r.PiezaDentalId}" : "--"))</td>
                                <td class="col-price">RD$@r.Precio.ToString("N2")</td>
                                <td>
                                    @switch (r.Estado)
                                    {
                                        case EstadoTratamiento.Completado:
                                            <span class="badge badge-completado">Completado</span>
                                            break;
                                        case EstadoTratamiento.EnProceso:
                                            <span class="badge badge-proceso">En proceso</span>
                                            break;
                                        case EstadoTratamiento.Pendiente:
                                            <span class="badge badge-pendiente">Pendiente</span>
                                            break;
                                        case EstadoTratamiento.Cancelado:
                                            <span class="badge badge-cancelado">Cancelado</span>
                                            break;
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <button class="btn-action" title="Editar">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="action-icon">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <div class="table-footer">
                <span>@realizadosFiltrados.Count registros</span>
                <span class="pagination-indicator">1</span>
            </div>
        </div>
    }
</div>

<!-- MODAL: NUEVO TRATAMIENTO (CATÁLOGO) -->
@if (mostrarModalCatalogo)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h3 class="modal-title">@(tratamientoEditando.Id == 0 ? "Nuevo tratamiento" : "Editar tratamiento")</h3>
                <button class="modal-close-btn" @onclick="CerrarModales">&times;</button>
            </div>

            @if (!string.IsNullOrEmpty(errorModal))
            {
                <div class="alert-error">@errorModal</div>
            }

            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Nombre del tratamiento</label>
                    <input type="text" @bind="tratamientoEditando.Nombre" class="form-control" />
                </div>

                <div class="form-group">
                    <label class="form-label">Descripción</label>
                    <textarea rows="3" @bind="tratamientoEditando.Descripcion" class="form-control resize-none"></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">Precio base (RD$)</label>
                    <input type="number" step="0.01" @bind="tratamientoEditando.PrecioBase" class="form-control" />
                </div>

                <div class="form-group">
                    <label class="form-label">Estado</label>
                    <select @bind="tratamientoEditando.Estado" class="form-control">
                        <option value="@EstadoRegistro.Activo">Activo</option>
                        <option value="@EstadoRegistro.Inactivo">Inactivo</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CerrarModales">Cancelar</button>
                <button class="btn-primary" @onclick="GuardarTratamientoCatalogo">Guardar</button>
            </div>
        </div>
    </div>
}

<!-- MODAL: REGISTRAR TRATAMIENTO REALIZADO -->
@if (mostrarModalRealizado)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h3 class="modal-title">Registrar tratamiento realizado</h3>
                <button class="modal-close-btn" @onclick="CerrarModales">&times;</button>
            </div>

            @if (!string.IsNullOrEmpty(errorModal))
            {
                <div class="alert-error">@errorModal</div>
            }

            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Paciente</label>
                    <select @bind="nuevoRealizado.PacienteId" class="form-control">
                        <option value="0">Seleccione un paciente...</option>
                        @foreach (var p in pacientes)
                        {
                            <option value="@p.Id">@p.Nombres @p.Apellidos</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Tratamiento del Catálogo</label>
                    <select @bind="nuevoRealizado.TratamientoId" @bind:after="OnTratamientoSeleccionado" class="form-control">
                        <option value="0">Seleccione un tratamiento...</option>
                        @foreach (var t in listaTratamientos)
                        {
                            <option value="@t.Id">@t.Nombre (RD$@t.PrecioBase.ToString("N2"))</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Odontólogo</label>
                    <select @bind="nuevoRealizado.OdontologoId" class="form-control">
                        <option value="0">Seleccione un odontólogo...</option>
                        @foreach (var o in odontologos)
                        {
                            <option value="@o.Id">@o.Nombres @o.Apellidos</option>
                        }
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label class="form-label">Pieza Dental</label>
                        <select @bind="piezaDentalSeleccionadaStr" class="form-control">
                            <option value="">Ninguna / No aplica (General)</option>
                            @if (piezasDentales.Any())
                            {
                                @foreach (var pd in piezasDentales)
                                {
                                    <option value="@pd.Id">@pd.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Precio (RD$)</label>
                        <input type="number" step="0.01" @bind="nuevoRealizado.Precio" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Estado</label>
                    <select @bind="nuevoRealizado.Estado" class="form-control">
                        <option value="@EstadoTratamiento.Pendiente">Pendiente</option>
                        <option value="@EstadoTratamiento.EnProceso">En proceso</option>
                        <option value="@EstadoTratamiento.Completado">Completado</option>
                        <option value="@EstadoTratamiento.Cancelado">Cancelado</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Observaciones</label>
                    <textarea rows="2" @bind="nuevoRealizado.Observaciones" placeholder="Notas clínicas..." class="form-control resize-none"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CerrarModales">Cancelar</button>
                <button class="btn-primary" @onclick="GuardarTratamientoRealizado">Guardar</button>
            </div>
        </div>
    </div>
}

<style>
