@using Odentra.Data.Entities
@using Odentra.UI.Formatting

@* Badge reutilizable para mostrar el estado clínico de un tratamiento realizado.
   Se usa en la tabla de Realizados y en el detalle. *@
<span class="tratamiento-badge @Clase">@Texto</span>

@code {
    // Estado que recibe el componente desde la página que lo usa.
    [Parameter, EditorRequired]
    public EstadoTratamiento Estado { get; set; }

    // Clase CSS según el estado; cada una tiene su color en el archivo .razor.css.
    private string Clase => Estado switch
    {
        EstadoTratamiento.Completado => "badge-completado",
        EstadoTratamiento.EnProceso => "badge-proceso",
        EstadoTratamiento.Pendiente => "badge-pendiente",
        EstadoTratamiento.Cancelado => "badge-cancelado",
        _ => "badge-pendiente"
    };

    // Texto legible ("En proceso" en vez de "EnProceso").
    private string Texto => Formato.Estado(Estado);
}
